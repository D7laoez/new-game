{
  "name": "party-game-collection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "auto-sync": "node scripts/auto-sync.js",
    "cap:init": "cap init \"Party Game Collection\" com.partygames.collection --web-dir=dist",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:apk:debug": "npm run android:build && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run android:build && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:build && cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "happy-dom": "^21.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
